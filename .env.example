# Copy this file to .env and adjust values.
# IMPORTANT: Vite exposes every VITE_-prefixed variable to the browser bundle.
# Never put API keys, tokens, or anything secret in a VITE_ variable —
# only public, non-sensitive config belongs here.

VITE_INSTAGRAM_HANDLE=heyfitmonk
VITE_WHATSAPP_NUMBER=910000000000
VITE_CONTACT_EMAIL=hello@example.com
